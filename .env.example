# Copy this file to .env.local and fill in your own keys:
#   cp .env.example .env.local
# Create React App only exposes variables prefixed with REACT_APP_.
# Restart `npm start` after changing these values.
# Note: REACT_APP_* values are bundled into the client JS and are visible to anyone using the app.

# GeoDB Cities API (RapidAPI) - city search: https://rapidapi.com/wirefreethought/api/geodb-cities
REACT_APP_GEO_API_KEY=your_rapidapi_key_here
REACT_APP_GEO_API_HOST=wft-geo-db.p.rapidapi.com
REACT_APP_GEO_API_URL=https://wft-geo-db.p.rapidapi.com/v1/geo

# OpenWeatherMap API - current weather and forecast: https://home.openweathermap.org/api_keys
REACT_APP_WEATHER_API_KEY=your_openweathermap_key_here
REACT_APP_WEATHER_API_URL=https://api.openweathermap.org/data/2.5
